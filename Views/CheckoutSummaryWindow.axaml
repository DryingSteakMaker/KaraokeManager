<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:KaraokeManager.ViewModels" x:Class="KaraokeManager.Views.CheckoutSummaryWindow" x:DataType="vm:RoomDetailViewModel" x:CompileBindings="False" Width="520" Height="620" MinWidth="520" MinHeight="620" CanResize="False" WindowStartupLocation="CenterOwner" Title="Kiểm tra hóa đơn" Background="#FFFFFF" Foreground="#263B35" RequestedThemeVariant="Light">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18" RowSpacing="10">
    <StackPanel Spacing="3"><TextBlock Text="Kiểm tra hóa đơn" FontSize="20" FontWeight="Bold"/><TextBlock Text="{Binding Room.Name}" FontSize="15"/><TextBlock Text="{Binding Main.InvoiceManager.CheckoutBillableMinutes, StringFormat='{}{0} phút sử dụng'}"/></StackPanel>
    <ScrollViewer Grid.Row="1"><StackPanel Spacing="8">
      <Border Padding="10" CornerRadius="8" Background="#F4F6F4"><StackPanel Spacing="5"><TextBlock Text="Chi tiết" FontWeight="Bold"/><TextBlock Text="{Binding Main.InvoiceManager.CheckoutRoomAmount, StringFormat='{}Tiền phòng: {0:N0} ₫'}"/><TextBlock Text="{Binding Main.InvoiceManager.CheckoutSingerAmount, StringFormat='{}Nhân viên hát cùng: {0:N0} ₫'}"/><TextBlock Text="{Binding Main.InvoiceManager.CheckoutProductAmount, StringFormat='{}Mặt hàng: {0:N0} ₫'}"/><ItemsControl ItemsSource="{Binding Main.InvoiceManager.CheckoutLines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OrderLineSnapshot"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat='{}× {0}'}"/><TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat='{}{0:N0} ₫'}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Main.InvoiceManager.CheckoutSubtotal, StringFormat='{}Tạm tính: {0:N0} ₫'}" FontWeight="SemiBold"/></StackPanel></Border>
      <TextBlock Text="Giảm giá (không bắt buộc)" FontWeight="Bold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><ComboBox ItemsSource="{Binding Main.InvoiceManager.DiscountTypes}" SelectedItem="{Binding Main.InvoiceManager.DiscountType}"/><TextBox Grid.Column="1" Text="{Binding Main.InvoiceManager.DiscountInput}" PlaceholderText="Số tiền hoặc %"/></Grid>
      <TextBlock Text="{Binding Main.InvoiceManager.DiscountAmount, StringFormat='{}Tiền giảm: {0:N0} ₫'}"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><TextBlock Text="Phụ thu" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Main.InvoiceManager.SurchargeInput}" PlaceholderText="Số tiền phụ thu"/></Grid>
      <TextBlock Text="{Binding Main.InvoiceManager.CheckoutTotal, StringFormat='{}{0:N0} ₫'}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right"/><TextBlock Text="{Binding Main.InvoiceManager.Message}" Foreground="#A23D32" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Quay lại" Click="Cancel_Click"/><Button Content="{Binding CheckoutConfirmText}" Background="#263B35" Foreground="White" Click="Confirm_Click"/></StackPanel>
  </Grid>
</Window>
