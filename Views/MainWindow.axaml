<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KaraokeManager.ViewModels"
        xmlns:models="using:KaraokeManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="960"
        x:Class="KaraokeManager.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="False"
        FontSize="{Binding InterfaceFontSize}"
        Background="{DynamicResource CanvasBrush}"
        Width="1440" Height="940" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Title="{Binding ShopName}">

  <Window.Styles>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="25"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#20242B"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#555D66"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="Button.filter"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#3F4944"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="Button.filter:pointerover"><Setter Property="Background" Value="#F0F1F4"/><Setter Property="Foreground" Value="#3F4944"/></Style>
    <Style Selector="Button.navItem"><Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}"/></Style>
    <Style Selector="Button.navItem:pointerover"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/><Setter Property="Foreground" Value="{DynamicResource NavigationTextBrush}"/></Style>
    <Style Selector="Button.filter.active"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.filter.active:pointerover"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="16,10"/></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.roomAction"><Setter Property="Background" Value="#F1F3F4"/><Setter Property="Foreground" Value="#343A42"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,8"/></Style>
    <Style Selector="Button.roomAction:pointerover"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Style>
  </Window.Styles>

  <Grid>
  <Grid IsVisible="{Binding IsAuthenticated}" ColumnDefinitions="230,*">
    <Border Grid.Column="0" Background="{DynamicResource NavigationBrush}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="20,24">
        <StackPanel Orientation="Horizontal" Spacing="11" Margin="3,0,0,34">
          <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource AccentTintBrush}"><Grid><Image Source="{Binding ShopLogo}" Stretch="UniformToFill" IsVisible="{Binding HasShopLogo}"/></Grid></Border>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding ShopName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="QUẢN LÝ VẬN HÀNH" FontSize="9" Foreground="{DynamicResource NavigationMutedBrush}"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="6">
          <TextBlock Text="TỔNG QUAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavigationMutedBrush}" Margin="8,0,0,8"/>
          <Button Classes="filter navItem" Classes.active="{Binding IsRoomsSection}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Rooms"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▦" FontSize="17"/><TextBlock Text="Sơ đồ phòng" VerticalAlignment="Center"/></StackPanel></Button>
          <Button Classes="filter navItem" Classes.active="{Binding IsRoomManagementSection}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="RoomManagement"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▩" FontSize="16"/><TextBlock Text="Quản lý phòng"/></StackPanel></Button>
          <Button Classes="filter navItem" Classes.active="{Binding IsBookingsSection}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Bookings"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▤" FontSize="16"/><TextBlock Text="Đặt phòng"/></StackPanel></Button>
          <Button Classes="filter navItem" Classes.active="{Binding IsProductsSection}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Products"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="＋" FontSize="16"/><TextBlock Text="Dịch vụ &amp; món"/></StackPanel></Button>
          <Button Classes="filter navItem" Classes.active="{Binding IsInvoicesSection}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Invoices"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="▧" FontSize="16"/><TextBlock Text="Lịch sử hóa đơn"/></StackPanel></Button>
          <Button Classes="filter navItem" Classes.active="{Binding IsReportsSection}" HorizontalContentAlignment="Left" Command="{Binding NavigateCommand}" CommandParameter="Reports"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="◷" FontSize="16"/><TextBlock Text="Báo cáo"/></StackPanel></Button>
          <TextBlock Text="HỆ THỐNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NavigationMutedBrush}" Margin="8,25,0,8"/>
          <Button Classes="filter navItem" Classes.active="{Binding IsSettingsSection}" HorizontalContentAlignment="Left" Command="{Binding OpenSettingsCommand}"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="⚙" FontSize="16"/><TextBlock Text="Cài đặt"/></StackPanel></Button>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#CDD7D1" BorderThickness="0,1,0,0" Padding="4,17,4,0">
          <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentTintBrush}"><TextBlock Text="NV" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding CurrentUserDisplay}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold"/><Button Classes="filter navItem" Command="{Binding AccountManager.SignOutCommand}" Content="Đăng xuất" Padding="0" FontSize="10" HorizontalAlignment="Left"/></StackPanel></StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="34,28,34,36" Spacing="24">
       <StackPanel Spacing="24" IsVisible="{Binding IsRoomsSection}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel><TextBlock Text="{Binding TodayLabel}" Classes="muted"/><TextBlock Text="Sơ đồ phòng" Classes="heading" Margin="0,4,0,0"/></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="13,9" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="◷" Foreground="#626B75"/><TextBlock Text="{Binding CurrentTime}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/></StackPanel></Border>
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
          <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="TỔNG SỐ PHÒNG" Classes="muted" FontSize="10"/><TextBlock Text="{Binding TotalRooms}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,9,0,0"/><TextBlock Text="Đang vận hành" Classes="muted" FontSize="11" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentTintBrush}"><TextBlock Text="▦" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
          <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="ĐANG SỬ DỤNG" Classes="muted" FontSize="10"/><TextBlock Text="{Binding InUseCount}" FontSize="27" FontWeight="SemiBold" Foreground="#D97745" Margin="0,9,0,0"/><TextBlock Text="Phòng có khách" Classes="muted" FontSize="11" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="#FCF1EB"><TextBlock Text="♫" FontSize="18" Foreground="#D97745" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
          <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="PHÒNG CÒN TRỐNG" Classes="muted" FontSize="10"/><TextBlock Text="{Binding AvailableCount}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,9,0,0"/><TextBlock Text="Sẵn sàng phục vụ" Classes="muted" FontSize="11" Margin="0,2,0,0"/></StackPanel><Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="#EAF5F0"><TextBlock Text="✓" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
          <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="DOANH THU HÔM NAY" Classes="muted" FontSize="10"/><TextBlock Text="{Binding TodayRevenue}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,11,0,0"/><TextBlock Text="Tạm tính đến hiện tại" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Width="40" Height="40" CornerRadius="12" Background="{DynamicResource AccentTintBrush}"><TextBlock Text="₫" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></Border>
        </Grid>

        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20,17" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Tình hình kinh doanh" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Tổng giá trị món đã gọi ở các phòng đang mở" Classes="muted" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><TextBlock Text="ĐƠN MÓN ĐANG MỞ" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><TextBlock Text="{Binding ActiveRevenue}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></StackPanel></Grid>
        </Border>

        <StackPanel Spacing="15">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Danh sách phòng" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="Theo dõi trạng thái và lượt sử dụng theo thời gian thực" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Classes="filter" BorderThickness="1" BorderBrush="#E2E5E8" Background="{DynamicResource SurfaceBrush}"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="☷"/><TextBlock Text="Bộ lọc"/></StackPanel></Button></Grid>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Button Classes="filter" Command="{Binding SelectFilterCommand}" CommandParameter="Tất cả"><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="Tất cả"/><Border Background="#E9ECEF" CornerRadius="8" Padding="6,1"><TextBlock Text="{Binding TotalRooms}" FontSize="10"/></Border></StackPanel></Button>
            <Button Classes="filter" Command="{Binding SelectFilterCommand}" CommandParameter="Trống"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="7" Height="7" CornerRadius="4" Background="#329B78" VerticalAlignment="Center"/><TextBlock Text="Trống"/><TextBlock Text="{Binding AvailableCount}" Classes="muted" FontSize="10"/></StackPanel></Button>
            <Button Classes="filter" Command="{Binding SelectFilterCommand}" CommandParameter="Đang sử dụng"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="7" Height="7" CornerRadius="4" Background="#D97745" VerticalAlignment="Center"/><TextBlock Text="Đang sử dụng"/><TextBlock Text="{Binding InUseCount}" Classes="muted" FontSize="10"/></StackPanel></Button>
            <Button Classes="filter" Command="{Binding SelectFilterCommand}" CommandParameter="Đã đặt"><StackPanel Orientation="Horizontal" Spacing="7"><Border Width="7" Height="7" CornerRadius="4" Background="#7A68C7" VerticalAlignment="Center"/><TextBlock Text="Đã đặt"/><TextBlock Text="{Binding ReservedCount}" Classes="muted" FontSize="10"/></StackPanel></Button>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding FilteredRooms}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemWidth="260" ItemHeight="190" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:RoomViewModel">
                <Border Margin="0,0,14,14" Width="246" Height="176" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" BorderBrush="#E6E8EB" BorderThickness="1" Padding="16" DoubleTapped="RoomCard_DoubleTapped">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Code}" FontSize="10" FontWeight="Bold" Foreground="#9399A2"/><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/></StackPanel><Border Grid.Column="1" Background="#F3F4F5" CornerRadius="6" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding Type}" FontSize="10" Foreground="#656D77"/></Border></Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColor}"/><TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/><TextBlock Text="·" Foreground="#626B75"/><TextBlock Text="{Binding Capacity}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="khách" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                    <Grid Grid.Row="2"><TextBlock Text="Nhấn đúp để mở chi tiết phòng" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
       </StackPanel>
        <StackPanel IsVisible="{Binding IsBookingsSection}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="Quản lý đặt phòng" Classes="heading"/><TextBlock Text="Lịch đặt trước và thông tin khách hàng" Classes="muted" Margin="0,6,0,0"/></StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding BeginBookingCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="＋" FontSize="17"/><TextBlock Text="Đặt phòng mới" VerticalAlignment="Center"/></StackPanel></Button>
          </Grid>
          <Border IsVisible="{Binding BookingManager.IsFormVisible}" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
            <StackPanel Spacing="16">
              <TextBlock Text="{Binding BookingManager.FormTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5"><TextBlock Text="Tên khách" Classes="muted" FontSize="11"/><TextBox Text="{Binding BookingManager.GuestName}" PlaceholderText="Nhập tên khách"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5"><TextBlock Text="Số điện thoại" Classes="muted" FontSize="11"/><TextBox Text="{Binding BookingManager.GuestPhone}" PlaceholderText="Nhập số điện thoại"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5"><TextBlock Text="Phòng" Classes="muted" FontSize="11"/><ComboBox ItemsSource="{Binding BookingManager.Rooms}" SelectedItem="{Binding BookingManager.SelectedRoom}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:RoomViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Bắt đầu (dd/MM/yyyy HH:mm)" Classes="muted" FontSize="11"/><TextBox Text="{Binding BookingManager.StartTime}" PlaceholderText="dd/MM/yyyy HH:mm"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5"><TextBlock Text="Thời lượng (phút)" Classes="muted" FontSize="11"/><TextBox Text="{Binding BookingManager.DurationMinutes}" PlaceholderText="120"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom"><Button Classes="primary" Command="{Binding BookingManager.CreateBookingCommand}" Content="Lưu đặt phòng"/><Button Classes="filter" Command="{Binding BookingManager.CloseFormCommand}" Content="Đóng"/><TextBlock Text="{Binding BookingManager.ValidationMessage}" Foreground="#B5483A" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <StackPanel><TextBlock Text="Danh sách đặt phòng" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding BookingManager.Bookings.Count} đặt phòng" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel>
          <ItemsControl ItemsSource="{Binding BookingManager.Bookings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BookingRecord">
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="16" Margin="0,0,0,10" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="1.2*,1.2*,1.3*,1.1*,Auto" ColumnSpacing="14">
                    <StackPanel><TextBlock Text="{Binding GuestName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding GuestPhone}" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding RoomName}" FontWeight="SemiBold" Foreground="#394149"/><TextBlock Text="{Binding RoomCode}" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="{Binding TimeRange}" Foreground="#394149"/><TextBlock Text="{Binding StatusText}" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="#329B78" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button Classes="roomAction" IsEnabled="{Binding CanCancel}" Command="{Binding Manager.EditBookingCommand}" CommandParameter="{Binding}" Content="Sửa"/><Button Classes="roomAction" IsEnabled="{Binding CanCancel}" Command="{Binding Manager.CancelBookingCommand}" CommandParameter="{Binding}" Content="Hủy đặt"/></StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsRoomManagementSection}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Quản lý phòng" Classes="heading"/><TextBlock Text="Thông tin phòng, loại phòng và giá theo khung giờ" Classes="muted" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Classes="primary" Command="{Binding RoomManagement.OpenCreateCommand}" Content="＋  Thêm phòng" VerticalAlignment="Center"/></Grid>

          <Border IsVisible="{Binding RoomManagement.IsMoveFormVisible}" Background="#F1F7F3" CornerRadius="12" Padding="18" BorderBrush="#DDE9E0" BorderThickness="1">
            <Grid ColumnDefinitions="*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="Chuyển khách sang phòng khác" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding RoomManagement.SourceRoom.Name}" Classes="muted" FontSize="11" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding RoomManagement.AvailableDestinations}" SelectedItem="{Binding RoomManagement.SelectedDestination}" VerticalAlignment="Center"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:RoomViewModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="primary" Command="{Binding RoomManagement.MoveSessionCommand}" Content="Chuyển khách"/><Button Classes="filter" Command="{Binding RoomManagement.CloseMoveFormCommand}" Content="Đóng"/></StackPanel><TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding RoomManagement.MoveMessage}" Foreground="#B5483A" FontSize="11" Margin="0,8,0,0"/></Grid>
          </Border>

          <Border IsVisible="{Binding RoomManagement.IsEditorVisible}" Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
            <StackPanel Spacing="14"><TextBlock Text="{Binding RoomManagement.EditorTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5"><TextBlock Text="Mã phòng" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.RoomCodeInput}" IsReadOnly="True"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5"><TextBlock Text="Tên phòng" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.RoomNameInput}" PlaceholderText="Tên phòng"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="5"><TextBlock Text="Loại phòng" Classes="muted" FontSize="11"/><ComboBox ItemsSource="{Binding RoomManagement.RoomTypes}" SelectedItem="{Binding RoomManagement.RoomTypeInput}"/></StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Spacing="5"><TextBlock Text="Sức chứa" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.CapacityInput}" PlaceholderText="8"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5"><TextBlock Text="Giá cơ bản (₫/giờ)" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.HourlyRateInput}" PlaceholderText="110000"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Giá cao điểm (₫/giờ, tùy chọn)" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.PeakRateInput}" PlaceholderText="150000"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Spacing="5"><TextBlock Text="Bắt đầu cao điểm" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.PeakStartInput}" PlaceholderText="18:00"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Spacing="5"><TextBlock Text="Kết thúc cao điểm" Classes="muted" FontSize="11"/><TextBox Text="{Binding RoomManagement.PeakEndInput}" PlaceholderText="23:00"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Classes="primary" Command="{Binding RoomManagement.SaveRoomCommand}" Content="Lưu phòng"/><Button Classes="filter" Command="{Binding RoomManagement.CloseEditorCommand}" Content="Đóng"/><TextBlock Text="{Binding RoomManagement.Message}" Foreground="#B5483A" FontSize="11" VerticalAlignment="Center"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Spacing="10"><TextBlock Text="Danh sách phòng" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><ItemsControl ItemsSource="{Binding Rooms}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:RoomViewModel"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="11" Padding="15" Margin="0,0,0,8" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><Grid ColumnDefinitions="1.2*,*,*,*,Auto" ColumnSpacing="12"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding Code}" Classes="muted" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Type}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding Capacity} khách" Classes="muted" FontSize="10"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding HourlyRateText}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding PeakRateText}" Classes="muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" VerticalAlignment="Center"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Button x:CompileBindings="False" Classes="roomAction" Command="{Binding DataContext.RoomManagement.EditRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Sửa"/><Button x:CompileBindings="False" Classes="roomAction" Command="{Binding DataContext.RoomManagement.DeleteRoomCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Xóa"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding RoomManagement.Message}" Foreground="#B5483A" FontSize="11"/></StackPanel>
        </StackPanel>


        <StackPanel IsVisible="{Binding IsInvoicesSection}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Lịch sử hóa đơn" Classes="heading"/><TextBlock Text="Tra cứu và in hóa đơn đã lập" Classes="muted" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" Classes="roomAction" Command="{Binding RefreshPrinterStatusCommand}" Content="Kiểm tra máy in" VerticalAlignment="Center"/></Grid>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="Thông tin máy in" FontWeight="SemiBold"/><TextBlock Text="{Binding PrinterStatusMessage}" Classes="muted" Margin="0,4,0,0"/><TextBlock Text="{Binding PrinterStatus.Type, StringFormat='{}Loại kết nối: {0}'}" Classes="muted" IsVisible="{Binding IsPrinterConnected}"/></StackPanel></Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="10"><TextBlock Text="Lịch sử" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><ItemsControl ItemsSource="{Binding InvoiceManager.Invoices}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:InvoiceRecord"><Button x:CompileBindings="False" Command="{Binding DataContext.InvoiceManager.SelectInvoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,6"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Number}" FontWeight="SemiBold"/><TextBlock Text="{Binding RoomName}" Classes="muted" FontSize="10" Margin="0,3,0,0"/><TextBlock Text="{Binding StatusText}" Foreground="#A23D32" FontSize="10" IsVisible="{Binding IsCancelled}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding TotalText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding InvoiceManager.Message}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Chi tiết lịch sử" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.Number}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.StatusText}" Foreground="#A23D32" FontWeight="SemiBold"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.RoomName}" Classes="muted"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.IssuedAtText}" Classes="muted"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.BillableMinutes} phút đã tính" Classes="muted"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.SingerService.Count, StringFormat='{}{0} người hát cùng'}" Classes="muted"/><TextBlock Text="{Binding InvoiceManager.SelectedInvoice.SingerService.Amount, StringFormat='{}{0:N0} ₫'}" Classes="muted"/><TextBlock Text="Các món và dịch vụ" FontWeight="SemiBold" Margin="0,8,0,0"/><ItemsControl ItemsSource="{Binding InvoiceManager.SelectedInvoice.Lines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:OrderLineSnapshot"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name}" FontSize="11"/><TextBlock Text="{Binding Quantity, StringFormat='{}× {0}'}" Classes="muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding LineTotal, StringFormat='{}{0:N0} ₫'}" FontSize="11"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tiền phòng" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding InvoiceManager.SelectedInvoice.RoomAmount, StringFormat='{}{0:N0} ₫'}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dịch vụ" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding InvoiceManager.SelectedInvoice.ServiceAmount, StringFormat='{}{0:N0} ₫'}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Phụ thu" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding InvoiceManager.SelectedInvoice.Surcharge, StringFormat='{}{0:N0} ₫'}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Giảm giá" Classes="muted"/><TextBlock Grid.Column="1" Text="{Binding InvoiceManager.SelectedInvoice.Discount, StringFormat='{}{0:N0} ₫'}"/></Grid><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tổng cộng" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding InvoiceManager.SelectedInvoice.TotalText}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/></Grid><StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0"><Button Classes="primary" Command="{Binding InvoiceManager.ExportInvoiceCommand}" CommandParameter="{Binding InvoiceManager.SelectedInvoice}" Content="Xuất HTML"/><Button Classes="roomAction" IsEnabled="{Binding CanPrintSelectedInvoice}" Command="{Binding InvoiceManager.PrintInvoiceCommand}" CommandParameter="{Binding InvoiceManager.SelectedInvoice}" Content="In hóa đơn"/></StackPanel></StackPanel></Border>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsReportsSection}" Spacing="20"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="Báo cáo" Classes="heading"/><TextBlock Text="Thống kê từ các hóa đơn đã lưu" Classes="muted" Margin="0,6,0,0"/></StackPanel><ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding ReportPeriods}" SelectedItem="{Binding ReportPeriod}"/></Grid><Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="DOANH THU" Classes="muted" FontSize="10"/><TextBlock Text="{Binding ReportRevenue}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border><Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="TIỀN PHÒNG" Classes="muted" FontSize="10"/><TextBlock Text="{Binding ReportRoomRevenue}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border><Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="DỊCH VỤ" Classes="muted" FontSize="10"/><TextBlock Text="{Binding ReportServiceRevenue}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border><Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="LỢI NHUẬN ƯỚC TÍNH" Classes="muted" FontSize="10"/><TextBlock Text="{Binding ReportProfit}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/></StackPanel></Border></Grid><Grid ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="8"><TextBlock Text="Doanh thu theo phòng" FontSize="15" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding RevenueByRoom}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ReportRow"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Phòng sử dụng nhiều nhất" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"/><ItemsControl ItemsSource="{Binding MostUsedRooms}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ReportRow"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Món bán chạy" FontSize="15" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding BestSellers}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ReportRow"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,5"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Grid></StackPanel>

        <StackPanel IsVisible="{Binding IsSettingsSection}" Spacing="20">
          <StackPanel><TextBlock Text="Cài đặt" Classes="heading"/><TextBlock Text="Thiết lập đơn giản cho quán karaoke nhỏ" Classes="muted" Margin="0,6,0,0"/></StackPanel>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Thông tin quán" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Tên quán" Classes="muted"/><TextBox Text="{Binding ShopName}" PlaceholderText="Tên quán"/><TextBlock Text="Địa chỉ" Classes="muted"/><TextBox Text="{Binding ShopAddress}" PlaceholderText="Địa chỉ quán"/><TextBlock Text="Số điện thoại" Classes="muted"/><TextBox Text="{Binding ShopPhone}" PlaceholderText="Số điện thoại"/><TextBlock Text="Logo tùy chỉnh" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding ShopLogoPath}" PlaceholderText="Đường dẫn tới ảnh logo"/><Button Grid.Column="1" Classes="roomAction" Content="Chọn ảnh…" Click="ChooseShopLogo_Click"/></Grid><Image Source="{Binding ShopLogo}" Height="72" HorizontalAlignment="Left" IsVisible="{Binding HasShopLogo}" Stretch="Uniform"/><TextBlock Text="Tên quán, địa chỉ và số điện thoại sẽ xuất hiện trên hóa đơn." Classes="muted" FontSize="11"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Giao diện" FontSize="15" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="Màu chủ đạo" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding AccentColors}" SelectedItem="{Binding AccentColor}"/><Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}"/></Grid></StackPanel><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Chế độ" Classes="muted"/><ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding ThemeMode}"/></StackPanel></Grid><TextBlock Text="Cỡ chữ" Classes="muted"/><ComboBox ItemsSource="{Binding FontSizeOptions}" SelectedItem="{Binding FontSizeOption}"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="10"><TextBlock Text="Tùy chỉnh hóa đơn" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Lời chào cuối hóa đơn" Classes="muted"/><TextBox Text="{Binding InvoiceGreeting}" PlaceholderText="Cảm ơn quý khách!"/><TextBlock Text="Nội dung chân trang" Classes="muted"/><TextBox Text="{Binding InvoiceFooter}" PlaceholderText="Thông tin hoặc điều khoản bổ sung"/><TextBlock Text="Định dạng số hóa đơn" Classes="muted"/><ComboBox ItemsSource="{Binding InvoiceNumberFormats}" SelectedItem="{Binding InvoiceNumberFormat}"/><TextBlock Text="Số theo ngày sẽ có dạng HD20261015-001; số theo thời gian gồm cả giờ, phút và giây." Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="Giá và thời gian" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Giá phòng mặc định (₫/giờ)" Classes="muted"/><TextBox Text="{Binding DefaultHourlyRateInput}" PlaceholderText="110000"/><TextBlock Text="Làm tròn thời gian (phút)" Classes="muted"/><TextBox Text="{Binding DefaultRoundingInput}" PlaceholderText="15"/><TextBlock Text="Nhân viên hát cùng (₫/giờ/người)" Classes="muted"/><TextBox Text="{Binding SingerHourlyRateInput}" PlaceholderText="100000"/><TextBlock Text="{Binding SettingsMessage}" Foreground="{DynamicResource AccentBrush}" FontSize="11"/><TextBlock Text="{Binding DatabaseMessage}" Foreground="#B5483A" FontSize="11" TextWrapping="Wrap"/><Button Classes="primary" Command="{Binding SaveSettingsCommand}" Content="Lưu tất cả cài đặt" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="Sao lưu và khôi phục dữ liệu" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Ứng dụng tạo tối đa một bản sao lưu tự động mỗi ngày khi dữ liệu được lưu. Giữ lại 30 bản gần nhất." Classes="muted" TextWrapping="Wrap"/><Button Classes="roomAction" Command="{Binding CreateBackupNowCommand}" Content="Tạo bản sao lưu ngay" HorizontalAlignment="Left"/><TextBlock Text="Chọn bản sao lưu" Classes="muted"/><ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberBinding="{Binding Label}"/><TextBlock Text="Khôi phục sẽ thay thế dữ liệu hiện tại trong ứng dụng." Foreground="#A15A31" FontSize="11"/><Button Classes="primary" Command="{Binding RestoreSelectedBackupCommand}" Content="Khôi phục bản đã chọn" HorizontalAlignment="Left"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="Loại phòng" FontSize="15" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding RoomManagement.NewRoomTypeInput}" PlaceholderText="Tên loại phòng mới"/><Button Grid.Column="1" Classes="primary" Command="{Binding RoomManagement.AddRoomTypeCommand}" Content="Thêm loại"/><ComboBox Grid.Column="2" Width="190" ItemsSource="{Binding RoomManagement.RoomTypes}" SelectedItem="{Binding RoomManagement.RoomTypeToDelete}"/><Button Grid.Column="3" Classes="roomAction" Command="{Binding RoomManagement.DeleteRoomTypeCommand}" CommandParameter="{Binding RoomManagement.RoomTypeToDelete}" Content="Xóa loại"/></Grid><TextBlock Text="{Binding RoomManagement.Message}" Classes="muted" FontSize="11"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="Danh mục sản phẩm" FontSize="15" FontWeight="SemiBold"/><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding NewCategoryName}" PlaceholderText="Tên danh mục mới"/><Button Grid.Column="1" Classes="primary" Command="{Binding AddProductCategoryCommand}" Content="Thêm danh mục"/><ComboBox Grid.Column="2" Width="190" ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding SelectedCategoryToDelete}"/><Button Grid.Column="3" Classes="roomAction" Command="{Binding DeleteProductCategoryCommand}" CommandParameter="{Binding SelectedCategoryToDelete}" Content="Xóa"/></Grid><TextBlock Text="{Binding ProductMessage}" Classes="muted" FontSize="11"/></StackPanel></Border>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel Spacing="12"><TextBlock Text="Tài khoản quản lý" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Tên đăng nhập hiện tại" Classes="muted"/><TextBlock Text="{Binding AccountManager.LoginName}" FontWeight="SemiBold"/><TextBox Text="{Binding AccountManager.NewUserName}" PlaceholderText="Tên đăng nhập mới"/><TextBox Text="{Binding AccountManager.CurrentPassword}" PasswordChar="●" PlaceholderText="Mật khẩu hiện tại để đổi tên"/><Button Classes="roomAction" Command="{Binding AccountManager.ChangeUserNameCommand}" Content="Đổi tên đăng nhập" HorizontalAlignment="Left"/><TextBlock Text="Đổi mật khẩu" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBox Text="{Binding AccountManager.CurrentPassword}" PasswordChar="●" PlaceholderText="Mật khẩu hiện tại"/><TextBox Text="{Binding AccountManager.NewPassword}" PasswordChar="●" PlaceholderText="Mật khẩu mới"/><TextBox Text="{Binding AccountManager.ConfirmPassword}" PasswordChar="●" PlaceholderText="Xác nhận mật khẩu mới"/><TextBlock Text="{Binding AccountManager.Message}" Foreground="#B5483A" FontSize="11" TextWrapping="Wrap"/><Button Classes="primary" Command="{Binding AccountManager.ChangePasswordCommand}" Content="Lưu mật khẩu" HorizontalAlignment="Left"/></StackPanel></Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsProductsSection}" Spacing="20">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="Dịch vụ &amp; sản phẩm" Classes="heading"/><TextBlock Text="Danh mục mặt hàng và giá bán" Classes="muted" Margin="0,6,0,0"/></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="SẢN PHẨM ĐANG BÁN" Classes="muted" FontSize="10"/><TextBlock Text="{Binding ProductCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="18" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"><StackPanel><TextBlock Text="DANH MỤC" Classes="muted" FontSize="10"/><TextBlock Text="{Binding CategoryCount}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/></StackPanel></Border>
          </Grid>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="13" Padding="20" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
            <StackPanel Spacing="14">
              <TextBlock Text="{Binding ProductFormTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
              <Grid ColumnDefinitions="1.5*,*,*,*,*" ColumnSpacing="10">
                <StackPanel Spacing="5"><TextBlock Text="Tên sản phẩm" Classes="muted" FontSize="10"/><TextBox Text="{Binding ProductName}" PlaceholderText="Tên món"/></StackPanel>
                <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Danh mục" Classes="muted" FontSize="10"/><ComboBox ItemsSource="{Binding ProductCategories}" SelectedItem="{Binding ProductCategory}"/></StackPanel>
                <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="Đơn vị" Classes="muted" FontSize="10"/><TextBox Text="{Binding ProductUnit}" PlaceholderText="Lon"/></StackPanel>
                <StackPanel Grid.Column="3" Spacing="5"><TextBlock Text="Giá bán" Classes="muted" FontSize="10"/><TextBox Text="{Binding ProductPrice}" PlaceholderText="20000"/></StackPanel>
                <StackPanel Grid.Column="4" Spacing="5"><TextBlock Text="Giá vốn" Classes="muted" FontSize="10"/><TextBox Text="{Binding ProductCost}" PlaceholderText="10000"/></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding ProductMessage}" Classes="muted" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="primary" Command="{Binding AddProductCommand}" Content="{Binding ProductSaveButtonText}"/></Grid>
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding Products}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="14,13" Margin="0,0,0,8" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                  <Grid ColumnDefinitions="1.5*,*,*,*,*,Auto" ColumnSpacing="12">
                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/><TextBlock Text="{Binding Code}" Classes="muted" FontSize="10" Margin="0,4,0,0"/></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#59616B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Foreground="#59616B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding SalePriceText}" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="{Binding CostPriceText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><Button x:CompileBindings="False" Classes="roomAction" Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Sửa"/><Button x:CompileBindings="False" Classes="roomAction" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="Xóa"/></StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <Border IsVisible="{Binding IsLoginVisible}" Background="#F3F5F4">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="440">
      <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="18" Padding="34" BorderBrush="#E3E8E5" BorderThickness="1">
        <StackPanel Spacing="16">
          <StackPanel HorizontalAlignment="Center" Spacing="6"><Border Width="72" Height="72" CornerRadius="20" Background="{DynamicResource AccentTintBrush}"><Image Source="{Binding ShopLogo}" Stretch="Uniform" Margin="8"/></Border><TextBlock Text="{Binding ShopName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/><TextBlock Text="Đăng nhập" Classes="muted" HorizontalAlignment="Center"/></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="Tài khoản" FontSize="11" FontWeight="SemiBold"/><TextBox Text="{Binding AccountManager.UserNameInput}" PlaceholderText="Tên đăng nhập" Height="40"/></StackPanel>
          <StackPanel Spacing="6"><TextBlock Text="Mật khẩu" FontSize="11" FontWeight="SemiBold"/><TextBox Text="{Binding AccountManager.Password}" PasswordChar="●" PlaceholderText="Mật khẩu" Height="40"/></StackPanel>
          <TextBlock Text="{Binding AccountManager.Message}" Foreground="#B5483A" FontSize="11" TextWrapping="Wrap"/>
          <Button Classes="primary" Command="{Binding AccountManager.SignInCommand}" Content="Đăng nhập" HorizontalAlignment="Stretch"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
  </Grid>
</Window>
