<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KaraokeManager.Views.RoomStartEditWindow" Width="420" Height="260" MinWidth="420" MinHeight="260" CanResize="False" WindowStartupLocation="CenterOwner" Title="Thay đổi thời gian bắt đầu" Background="#FFFFFF" Foreground="#263B35" RequestedThemeVariant="Light">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
    <TextBlock Text="Thay đổi thời gian bắt đầu" FontSize="18" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Spacing="10">
      <StackPanel Spacing="4"><TextBlock Text="Ngày bắt đầu" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="DateInput" PlaceholderText="dd/MM/yyyy"/></StackPanel>
      <StackPanel Spacing="4"><TextBlock Text="Giờ bắt đầu" FontSize="12" FontWeight="SemiBold"/><TextBox x:Name="TimeInput" PlaceholderText="HH:mm"/></StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="#A23D32" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Xác nhận" Background="#263B35" Foreground="White" Click="Confirm_Click"/>
      <Button Content="Hủy" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
