<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KaraokeManager.Views.OrderQuantityWindow" Width="340" Height="190" CanResize="False" WindowStartupLocation="CenterOwner" Title="Đổi số lượng">
  <StackPanel Margin="18" Spacing="10"><TextBlock x:Name="ItemName" FontWeight="Bold" TextWrapping="Wrap"/><TextBox x:Name="QuantityBox" PlaceholderText="Số lượng"/><TextBlock x:Name="ErrorText" Foreground="#A23D32"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Hủy" Click="Cancel_Click"/><Button Content="Lưu" Click="Save_Click"/></StackPanel></StackPanel>
</Window>
