<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="KaraokeManager.Views.RoomCancelConfirmationWindow" Width="390" Height="190" CanResize="False" WindowStartupLocation="CenterOwner" Title="Hủy lượt phòng" Background="#FFFFFF" Foreground="#263B35" RequestedThemeVariant="Light">
  <Border Background="#FFFFFF" Padding="20"><Grid RowDefinitions="*,Auto" RowSpacing="12"><TextBlock x:Name="PromptText" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"><Button Content="Quay lại" Click="Cancel_Click"/><Button Content="Hủy phòng" Background="#A23D32" Foreground="White" Click="Confirm_Click"/></StackPanel></Grid></Border>
</Window>
